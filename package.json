{
  "name": "ngx-transformers-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test ngx-transformers",
    "test:ci": "ng test ngx-transformers --no-watch --coverage",
    "lint": "ng lint",
    "format": "prettier --write \"projects/**/*.ts\" \".storybook/*.ts\" \"scripts/*.mjs\" eslint.config.mjs",
    "format:check": "prettier --check \"projects/**/*.ts\" \".storybook/*.ts\" \"scripts/*.mjs\" eslint.config.mjs",
    "build:lib": "node scripts/sync-package-files.mjs && ng build ngx-transformers",
    "build:demo": "ng build demo",
    "storybook": "ng run demo:storybook",
    "build-storybook": "ng run demo:build-storybook",
    "docs:dev": "npm run dev -w website",
    "docs:build": "npm run build -w website",
    "build:pages": "node scripts/build-pages.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build:lib && changeset publish"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@huggingface/transformers": "^4.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.1.8",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/angular": "^10.6.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "projects/ngx-transformers",
    "website"
  ]
}
