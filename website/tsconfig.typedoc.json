{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "resolveJsonModule": true,
    "types": [],
    "paths": {
      "ngx-transformers/worker": [
        "../projects/ngx-transformers/worker/src/public-api.ts"
      ]
    }
  },
  "include": [
    "../projects/ngx-transformers/src",
    "../projects/ngx-transformers/worker/src"
  ],
  "exclude": [
    "../projects/ngx-transformers/src/**/*.spec.ts",
    "../projects/ngx-transformers/src/**/*.stories.ts"
  ]
}
